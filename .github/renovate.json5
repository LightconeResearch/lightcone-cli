{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  // Actions only; Python and npm dependencies are updated by hand.
  enabledManagers: ['github-actions', 'custom.regex'],
  schedule: ['before 6am on monday'],
  // Let a release age a week before proposing it: a compromised or
  // broken release is usually caught and pulled within days.
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      // Only `uses:` references. Runner labels and the versions passed to
      // setup actions are choices: tests.yml's uv must stay the scaffold's
      // floor, and its runner is pinned until #270.
      matchManagers: ['github-actions'],
      matchDepTypes: ['uses-with', 'github-runner'],
      enabled: false,
    },
    {
      matchManagers: ['github-actions', 'custom.regex'],
      groupName: 'GitHub Actions',
    },
  ],
  customManagers: [
    {
      // The gh-actions-lock extension lint.yml installs to verify the lock.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['gh extension install github/gh-actions-lock --pin (?<currentValue>v\\S+)'],
      depNameTemplate: 'github/gh-actions-lock',
      datasourceTemplate: 'github-releases',
    },
  ],
}
