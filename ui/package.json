{
  "name": "@lightcone/serve-app",
  "private": true,
  "description": "The front end `lc serve` serves: JupyterLab, trimmed to an ASTRA explorer.",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsc && rspack",
    "build:prod": "tsc && rspack --mode=production",
    "clean": "rimraf lib ../src/lightcone/app/static ../src/lightcone/app/schemas ../src/lightcone/app/themes"
  },
  "dependencies": {
    "@astra-spec/sdk": "^0.1.2",
    "@astra-spec/ui": "https://pkg.pr.new/@astra-spec/ui@36",
    "@jupyterlab/application": "^4.6.4",
    "@jupyterlab/application-extension": "^4.6.4",
    "@jupyterlab/apputils": "^4.6.4",
    "@jupyterlab/apputils-extension": "^4.6.4",
    "@jupyterlab/coreutils": "^6.6.4",
    "@jupyterlab/services": "^7.6.4",
    "@jupyterlab/statedb": "^4.6.4",
    "@jupyterlab/theme-dark-extension": "^4.6.4",
    "@jupyterlab/theme-light-extension": "^4.6.4",
    "@jupyterlab/translation-extension": "^4.6.4",
    "@jupyterlab/ui-components": "^4.6.4",
    "@lumino/signaling": "^2.1.3",
    "@lumino/widgets": "^2.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.4",
    "@rspack/cli": "^2.0.2",
    "@rspack/core": "^2.2.8",
    "@types/react": "^18.3.0",
    "css-loader": "^7.1.4",
    "mini-svg-data-uri": "^1.4.4",
    "rimraf": "~5.0.5",
    "style-loader": "^4.0.0",
    "typescript": "~5.7.0"
  },
  "jupyterlab": {
    "extensions": [
      "@jupyterlab/application-extension",
      "@jupyterlab/apputils-extension",
      "@jupyterlab/theme-dark-extension",
      "@jupyterlab/theme-light-extension",
      "@jupyterlab/translation-extension"
    ]
  }
}
